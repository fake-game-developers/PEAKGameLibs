<?xml version="1.0" encoding="utf-8"?>
<package>
  <metadata>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>

    <!-- Match PEAK version.txt (2.5.a → 2.5.0). Bump when regenerating from a new game build. -->
    <version>2.5.0</version>

    <!-- Own package id: nuget.org PEAKGameLibs is owned by Locochoco and cannot be updated from this fork. -->
    <id>FakeGameDevelopers.PEAKGameLibs</id>
    <title>FakeGameDevelopers.PEAKGameLibs</title>
    <authors>FakeGameDevelopers</authors>
    <description>Stripped and publicized PEAK Managed assemblies for mod CI (PEAK 2.5.a). Fork of loco-choco/PEAKGameLibs.</description>
    <projectUrl>https://github.com/fake-game-developers/PEAKGameLibs</projectUrl>
    <repository type="git" url="https://github.com/fake-game-developers/PEAKGameLibs.git" />
    <tags>PEAK BepInEx GameLibs</tags>
  </metadata>
</package>
